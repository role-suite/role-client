// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The bundle/executable filename. Keep this ASCII: a non-ASCII PRODUCT_NAME makes
// the .app path use a different Unicode normalization than Xcode's signing step
// expects, which fails CodeSign ("code object is not signed at all").
PRODUCT_NAME = relay

// The user-facing name is localized to "Röle" via Runner/{en,Base}.lproj/
// InfoPlist.strings (plus LSHasLocalizedDisplayName in Info.plist), so Finder,
// the Dock, and the menu bar show Röle while the signed bundle keeps its ASCII
// relay.app filename — a non-ASCII PRODUCT_NAME breaks Xcode's CodeSign step.

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.devora.relay

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2025 com.devora. All rights reserved.
