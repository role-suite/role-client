root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 150

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kt,gradle,gradle.kts}]
indent_size = 4

[*.{swift,m,h}]
indent_size = 4

[*.{bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
