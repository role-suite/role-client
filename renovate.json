{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "UTC",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group the Riverpod packages; they must move together",
      "matchPackageNames": [
        "riverpod",
        "flutter_riverpod",
        "riverpod_annotation",
        "riverpod_generator",
        "riverpod_lint",
        "riverpod_analyzer_utils"
      ],
      "groupName": "Riverpod packages"
    },
    {
      "description": "Group GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The Flutter SDK pin is a deliberate monthly upgrade",
      "matchManagers": ["fvm"],
      "groupName": "Flutter SDK",
      "schedule": ["before 9am on the first day of the month"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  }
}
