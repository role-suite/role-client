default_platform(:ios)

platform :ios do
  desc "Build with the match appstore identity and upload to TestFlight (internal testers)"
  lane :beta do
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true)

    sh("cd .. && flutter build ipa --release --export-method app-store")

    ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("No IPA found under build/ios/ipa after flutter build ipa.") if ipa_path.nil?

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY")
    )

    pilot(
      ipa: ipa_path,
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
